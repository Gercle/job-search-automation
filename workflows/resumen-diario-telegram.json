    {
      "parameters": {
        "jsCode": "// Filtra match_pct > 75 que todavia no se notificaron, arma el mensaje y los botones\nconst items = $input.all().map(i => i.json)\n  .filter(j => Number(j.match_pct) > 75 && !j.notificado && j.url)\n  .sort((a, b) => Number(b.match_pct) - Number(a.match_pct))\n  .slice(0, 15); // tope para no pasar el limite de largo de Telegram\n\nif (!items.length) return [];\n\nconst lineas = items.map((j, idx) =>\n  `${idx + 1}. *${j.titulo}* - ${j.empresa}\\n` +\n  `   \\ud83d\\udccd ${j.ubicacion} | \\ud83c\\udfaf ${j.match_pct}% match\\n` +\n  `   \\ud83d\\udca1 ${j.ats_tip || ''}`\n);\n\nconst texto = `\\ud83d\\udd25 *Ofertas con alto match de hoy* (${items.length})\\n\\n` + lineas.join('\\n\\n');\n\nconst inline_keyboard = items.map(j => ([{ text: `\\ud83d\\udd17 ${String(j.titulo || '').slice(0, 30)}`, url: j.url }]));\n\nreturn [{ json: { texto, inline_keyboard, urls: items.map(j => j.url) } }];"
      },
      "id": "2f274030-30d0-4702-8faa-a385f8188f41",
      "name": "Armar resumen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        7296,
        928
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('Config (Telegram)').first().json.telegram_bot_token }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Config (Telegram)').first().json.telegram_chat_id, text: $json.texto, parse_mode: 'Markdown', reply_markup: { inline_keyboard: $json.inline_keyboard } }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "bd072144-c090-4a1d-86d7-86e07f4c138f",
      "name": "Enviar Telegram",
